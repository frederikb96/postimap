{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "postimap",
  "type": "object",
  "additionalProperties": true,
  "required": ["config"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "Fixed at 1 -- see the comment in values.yaml for why."
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": { "type": "string" }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "resources": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": {
      "type": "object",
      "required": ["enabled", "path"],
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "pattern": "^/" }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowDNS": { "type": "boolean" },
        "egress": { "type": "array" }
      }
    },
    "config": {
      "type": "object",
      "description": "Freeform, deep-merged onto config/config.yaml in the image. Mirrors that file's structure so new sections can be added without chart changes.",
      "additionalProperties": true,
      "required": ["database"],
      "properties": {
        "database": {
          "type": "object",
          "required": ["host"],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "description": "PostgreSQL host. No usable default for an external database -- must be set."
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "name": { "type": "string", "minLength": 1 },
            "user": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "configOverridePath": { "type": "string", "minLength": 1 },
    "secret": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "dbPassword": { "type": "string" },
        "encryptionKey": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{64})?$",
          "description": "AES-256-GCM key, 64 hex chars, or empty to disable at-rest encryption."
        }
      }
    },
    "existingSecret": { "type": "string" },
    "existingSecretKeys": {
      "type": "object",
      "required": ["dbPassword", "encryptionKey"],
      "properties": {
        "dbPassword": { "type": "string", "minLength": 1 },
        "encryptionKey": { "type": "string", "minLength": 1 }
      }
    }
  }
}
