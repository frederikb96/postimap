{
  "name": "postimap",
  "version": "1.11.15",
  "description": "Bidirectional IMAP-to-PostgreSQL sync microservice",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frederikb96/postimap.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project pg-integration --project imap-integration --project dav-integration",
    "test:integration:pg": "vitest run --project pg-integration",
    "test:integration:imap": "vitest run --project imap-integration",
    "test:integration:dav": "vitest run --project dav-integration",
    "test:e2e": "vitest run --project e2e",
    "test:chaos": "vitest run --project chaos",
    "test:property": "vitest run --project property",
    "test:ci": "vitest run --reporter=junit --outputFile=test-results.xml",
    "test:coverage": "vitest run --coverage",
    "test:infra:down": "bash scripts/test-infra-down.sh",
    "migrate": "tsx src/db/migrate.ts",
    "prod:up": "podman compose --env-file .prod.env -f compose.yaml up -d",
    "prod:down": "podman compose -f compose.yaml down"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "imapflow": "^2.3.0",
    "kysely": "^0.29.7",
    "kysely-postgres-js": "^5.0.1",
    "mailparser": "^3.9.47",
    "nodemailer": "^10.1.7",
    "pg-listen": "^1.7.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.0",
    "tsdav": "^2.4.0",
    "undici": "^8.12.2",
    "yaml": "^2.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.1",
    "fast-check": "^4.0.0",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.1",
    "toxiproxy-node-client": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true
  }
}
